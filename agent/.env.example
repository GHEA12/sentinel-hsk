# Sentinel agent configuration — copy to .env and fill in.
# .env is gitignored. NEVER commit a real private key.

# HashKey Chain testnet (133). Mainnet is 177 — do not point this at mainnet
# without the mainnet-phase review (see ../README.md).
# testnet.hsk.xyz is the endpoint verified live from our sandbox in Phase 2;
# the alt.technology endpoint did not answer, and dRPC's free plan excludes
# this chain.
RPC_URL=https://testnet.hsk.xyz
CHAIN_ID=133

# HSKSwap V3 on testnet (133) — verified in ../RESEARCH.md (Phase 2).
ROUTER_ADDRESS=0xa6914E66690c6794244B5f66a09eAEbf66254237
QUOTER_ADDRESS=0x73820d9eE5Bf1BfcD429580320FC7A374E8fa1cC

# Deployed guard (fill after the testnet deploy — see ../scripts/live-run.js)
GUARD_ADDRESS=0x0000000000000000000000000000000000000000

# Trading pair on testnet: test USDT (quote, 18 dp) / WHSK (trade, 18 dp).
# Their fee-500 pool (0xff2b7E501C870980Bf5641B4a70D0F9fb0f6f6ab) holds real
# testnet liquidity; verified on-chain in Phase 2 (see ../RESEARCH.md).
QUOTE_TOKEN=0x98b6173a8b7dfc52ce8bc88f1184a918a1ccaa4f
TRADE_TOKEN=0xca8aaceec5db1e91b9ed3a344ba026c4a2b3ebf6
QUOTE_DECIMALS=18
TRADE_DECIMALS=18
FEE_TIER=500

# Agent wallet — the address authorized in SentinelGuard. TESTNET ONLY.
# This placeholder is not a real key; scripts/live-run.js generates a
# throwaway testnet keypair into scripts/.env on first run.
AGENT_PRIVATE_KEY=0xREPLACE_WITH_THROWWAWAY_TESTNET_KEY

# Behaviour
POLL_MS=15000
TRADE_AMOUNT_QUOTE=10
SLIPPAGE_BPS=100
DRY_RUN=true
