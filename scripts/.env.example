# Sentinel live-run keys — TESTNET (chain 133) ONLY.
# Copy to .env and fill with THROWAWAY testnet keys, or leave the file
# absent and live-run.js will generate a fresh pair into .env itself.
# NEVER put a mainnet key or a real wallet key here.
OWNER_PRIVATE_KEY=0xREPLACE_WITH_A_THROWAWAY_TESTNET_KEY
AGENT_PRIVATE_KEY=0xREPLACE_WITH_A_THROWAWAY_TESTNET_KEY
